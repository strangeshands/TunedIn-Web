    "elevatedIlMultiplier": 0.95,
    "elevatedFpedMultiplier": 0.95,
    "elevatedErrorRate": 0.1
  },
  "baseline": {
    "defaultMode": "records",
    "enabledModes": [
      "records",
      "timed"
    ],
    "recordTarget": 20
  }
