{
  "version": "pilot",
  "buildVersion": "pilot-2.0.0",
  "randomizationSeed": "pilot2.0.0",
  "taskVersion": "fictional-records",
  "conditionOrders": {
    "A": [
      "No music",
      "Static music",
      "Adaptive music"
    ],
    "B": [
      "Static music",
      "Adaptive music",
      "No music"
    ],
    "C": [
      "Adaptive music",
      "No music",
      "Static music"
    ]
  },
